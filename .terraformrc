// Terraform normally downloads providers from a registry. Yours only exists on
// your machine, so this redirects `hashicorp.com/dev/dataminded` to the binary
// that `make build` drops in ./bin.
//
// The path is relative to your working directory, so run terraform from the
// repo root. Point Terraform at this file with:
//
//     export TF_CLI_CONFIG_FILE=$PWD/.terraformrc
//
// https://developer.hashicorp.com/terraform/cli/config/config-file#development-overrides-for-provider-developers
provider_installation {
  dev_overrides {
    "hashicorp.com/dev/dataminded" = "./bin"
  }
  direct {}
}
